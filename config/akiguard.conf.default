# AkiGuard settings. Usually changed from the menu bar, but you can edit this file by hand.
# The background service re-reads it every 15 seconds.

# Main rule: limit | discharge | full | off
#   limit     = stop charging at 'limit' %, resume when it drops 'sail' % below
#   discharge = run on battery while plugged in until 'discharge_to' %, then hold there
#   full      = charge to 100%
#   off       = AkiGuard does nothing (normal charging)
mode=limit
limit=80
sail=5
discharge_to=50

# 1 = if the battery is above the limit (e.g. 95% with limit 80%), discharge down to it first
auto_discharge=0

# Temporary top up from the menu bar (do not edit by hand)
override=off
override_until=0

# Schedules: schedule=HH:MM-HH:MM DAYS ACTION [VALUE]
#   DAYS   : 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat 7=Sun, or * for every day
#   ACTION : limit | discharge | full | off
# The higher schedule wins when they overlap. Windows can cross midnight.
# Examples (remove the # to enable):
# schedule=05:30-07:30 12345 full
# schedule=22:00-05:30 * limit 60
# schedule=12:00-13:00 * discharge 40
